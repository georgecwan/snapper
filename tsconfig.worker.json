{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "src/snapper/protocol.ts",
    "src/snapper/engine.ts",
    "src/snapper/judge.ts",
    "src/snapper/catalog.ts"
  ],
  "exclude": ["worker/**/*.test.ts", "src/**/*.test.ts"]
}

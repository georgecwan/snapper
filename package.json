{
  "name": "snapper",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs node scripts/dev.mjs",
    "build": "node scripts/with-app-env.mjs vite build --mode snapper && node scripts/build-worker-assets.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "npm run build",
    "preview": "node scripts/snapper-preview.mjs restart",
    "preview:restart": "node scripts/snapper-preview.mjs restart",
    "preview:stop": "node scripts/snapper-preview.mjs stop",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "npm run test:snapper",
    "lint": "eslint .",
    "lint:snapper": "eslint src/snapper src/components/snapper worker scripts/dev.mjs scripts/build-brand.mjs scripts/build-worker-assets.mjs scripts/snapper-preview.mjs scripts/test-integration.mjs vite.config.ts scripts/question-import.mjs scripts/question-import.test.mjs scripts/import-questions.mjs scripts/check-questions.mjs scripts/prepare-question-assets.mjs scripts/download-opentdb.mjs --max-warnings 0",
    "format": "prettier --write .",
    "build:legacy": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "test:snapper": "node --experimental-strip-types --test src/snapper/*.test.ts worker/*.test.ts scripts/question-import.test.mjs",
    "check:worker": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --env '' --dry-run --outdir dist/worker",
    "deploy": "npm run build && wrangler deploy --env ''",
    "test:template": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "check:browser": "node scripts/browser-smoke.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "questions:import": "node --experimental-strip-types scripts/import-questions.mjs",
    "questions:check": "node --experimental-strip-types scripts/check-questions.mjs",
    "questions:download:opentdb": "node scripts/download-opentdb.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "jose": "6.2.9",
    "jpeg-js": "^0.4.4",
    "kysely": "^0.28.5",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vite": "^8.2.0",
    "wrangler": "^4.141.0",
    "ws": "^8.21.3",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
